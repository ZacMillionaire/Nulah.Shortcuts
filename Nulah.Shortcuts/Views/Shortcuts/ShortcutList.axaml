<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Nulah.Shortcuts.ViewModels"
             xmlns:shortcuts="clr-namespace:Nulah.Shortcuts.Views.Shortcuts"
             xmlns:controls="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ShortcutListViewModel"
             x:Class="Nulah.Shortcuts.Views.Shortcuts.ShortcutList">
    <Design.DataContext>
        <viewModels:ShortcutListDesignModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,Auto,Auto">
        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="Black"
                Background="#eee"
                Padding="5">
            <StackPanel Grid.IsSharedSizeScope="True" Spacing="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Title"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Text="{Binding Title}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Shortcut"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Text="{Binding Link}" />
                </Grid>
                <Button HorizontalAlignment="Right" 
                        Command="{Binding CreateShortcutCommand}">
                    Create
                </Button>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2"
                    IsVisible="{Binding !Shortcuts.Count}">
            <TextBlock>No shortcuts</TextBlock>
        </StackPanel>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Shortcuts}"
                      IsVisible="{Binding Shortcuts.Count}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <shortcuts:ShortcutItem Margin="5" Title="{Binding Title}"
                                            ShortcutLink="{Binding ShortcutLocation}">
                        <shortcuts:ShortcutItem.ShortcutContent>
                            <StackPanel Background="Aqua">
                                <controls:HeroIcon Type="Backspace" />
                            </StackPanel>
                        </shortcuts:ShortcutItem.ShortcutContent>
                    </shortcuts:ShortcutItem>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>